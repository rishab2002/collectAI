# Railway variables for collectAI — README §8.6 (Cloudflare + Supabase + Railway).
#
# NOT a file the app reads. Railway has no .env: paste this into the `web`
# service's Variables (Raw Editor) and fill in the blanks there. Real values
# never go back into this file — it is tracked by git. The `recognizer`
# service needs only the four lines at the very end.
#
# Railway does not expand ${OTHER_VAR} the way a .env file does; values here
# are literal, except Railway's own references, written ${{service.VARIABLE}}.

# --- How requests reach the app -------------------------------------------
# railway = config from these variables, and nginx admits only requests that
# carry Cloudflare's X-Origin-Auth header (docker/nginx/origin-mode-railway.conf).
ORIGIN_MODE=railway
# `openssl rand -hex 32`. The same value goes into the Cloudflare transform
# rule. Anyone holding it can skip Cloudflare Access, so treat it like a password.
ORIGIN_SECRET=
# nginx listens on 80; this tells Railway where to send traffic.
PORT=80

# --- App ---------------------------------------------------------------------
APP_NAME=collectAI
APP_ENV=production
# `php artisan key:generate --show` on your Mac, then paste. Never rotate it
# casually: every session and encrypted value dies with the old key.
APP_KEY=
APP_DEBUG=false
APP_URL=https://collectai.club
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database: Supabase --------------------------------------------------------
# Supabase → Connect → "Session pooler" (not "Direct connection", which is
# IPv6-only, and not "Transaction pooler" on 6543, which breaks the prepared
# statements PHP's PDO uses).
DB_CONNECTION=pgsql
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
# postgres.<your project ref>, exactly as Supabase shows it.
DB_USERNAME=postgres.PROJECTREF
DB_PASSWORD=
DB_SSLMODE=require
# Only if migrations fail with `operator class "gin_trgm_ops" does not exist`.
# That happens when pg_trgm was switched on from Supabase's Extensions page,
# which installs it into a schema called `extensions` — out of scope for the
# `public` search path, so the trigram indexes cannot find it while the
# extension is installed and fine. Step 1 says not to enable extensions by
# hand for this reason; this is the way out if it already happened.
# DB_SEARCH_PATH=public,extensions

# --- Sessions, cache, queue: in Postgres, so there is no Redis to pay for -----
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
# Must stay ABOVE the worker's --timeout (300): below it, a slow job is handed
# to a second worker while the first is still running.
DB_QUEUE_RETRY_AFTER=360
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@collectai.club
MAIL_FROM_NAME=collectAI

# --- Photos: the R2 bucket you already have -----------------------------------
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=collectai-photos
R2_ENDPOINT=
R2_URL=https://img.collectai.club
CAPTURE_DISK=r2
CAPTURE_MAX_PHOTO_KB=12288

# --- First admin (AdminUserSeeder) ---------------------------------------------
ADMIN_NAME=Catalog Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- The queue worker and the scheduler, inside this service ---------------
# On Railway they run beside the website (docker/supervisord.conf): the hourly
# cleanup of unshared scan photos must run where the photos are, and one
# service costs less than three.
RUN_QUEUE_WORKER=true
RUN_SCHEDULER=true

# --- The scanner (the `recognizer` service) ------------------------------------
CATALOG_AI_DRIVER=local
# Reached over Railway's private network; the recognizer has no public domain.
# Written out literally, NOT as http://${{recognizer.RAILWAY_PRIVATE_DOMAIN}}:8080.
# Private DNS names are always <service name>.railway.internal, so there is
# nothing a reference buys here — and when a reference cannot be satisfied
# Railway substitutes nothing rather than failing, leaving "http://:8080": a
# scheme, no host, and a scan that dies on an unparseable URI. Measured on this
# deployment 2026-11-05, where it survived a redeploy. Change the hostname below
# if the service is named something other than `recognizer`.
RECOGNIZER_URL=http://recognizer.railway.internal:8080
# `openssl rand -hex 32`. The recognizer sends it to fetch the catalog index
# from GET /internal/recognition-index; without it that route is a 404.
RECOGNIZER_INDEX_TOKEN=
# Scan crops. Attach a Railway volume at /var/www/html/storage/app/private,
# or every redeploy deletes them (including the ones collectors agreed to share).
SCAN_DISK=local
PRIVACY_CONTACT_EMAIL=privacy@collectai.club

# --- Thresholds (unchanged from .env.production.example) ----------------------
REVIEW_AUTO_APPROVE_THRESHOLD=1.0
IMPORT_AUTO_APPROVE_THRESHOLD=0.9
IMPORT_GENERATION_THRESHOLD=0.65

# --- Optional ----------------------------------------------------------------
COLLECTAI_ANTHROPIC_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_INSIGHTS=false
EBAY_LISTINGS_FALLBACK=false
PRICE_DAILY_BUDGET=4500

# =============================================================================
# The `recognizer` service's variables — these five only, in ITS Raw Editor.
#
# RAILWAY_DOCKERFILE_PATH is how this service is pointed at the scanner's
# Dockerfile rather than the website's. Without it Railway finds the root
# `Dockerfile` by itself and deploys a second copy of the website, which starts
# cleanly and is entirely wrong. It replaces the deprecated config-as-code file
# path setting (railway/recognizer.json); see README §8.6.
#
# RAILWAY_DOCKERFILE_PATH=railway/recognizer.Dockerfile
# RECOGNIZER_INDEX_URL=http://${{web.RAILWAY_PRIVATE_DOMAIN}}/internal/recognition-index
# RECOGNIZER_INDEX_TOKEN=${{web.RECOGNIZER_INDEX_TOKEN}}
# ORIGIN_SECRET=${{web.ORIGIN_SECRET}}
# RECOGNIZER_TRUST_LOOKS=auto
