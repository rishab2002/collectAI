APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=diecast
DB_USERNAME=diecast
DB_PASSWORD=diecast

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=diecast_dev_key

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (photo storage). R2_ENDPOINT is the S3 API endpoint,
# https://<account-id>.r2.cloudflarestorage.com — used for uploads only.
# R2_URL is the public read URL: either the bucket's r2.dev subdomain or a
# custom domain. Uploads fail loudly if these are unset, by design.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Which disk the capture screen writes to, and the per-photo size cap in KB.
# Set CAPTURE_DISK=local to use the capture screen before the R2 credentials
# above are real; submission_photos.disk records the choice per row, so photos
# captured locally keep resolving after the switch.
CAPTURE_DISK=r2
CAPTURE_MAX_PHOTO_KB=12288

# Catalog admin, created by AdminUserSeeder. Leaving ADMIN_PASSWORD blank makes
# the seeder generate one and print it once.
ADMIN_NAME="Catalog Admin"
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# The credential every agent's Claude API call goes out under. Without it,
# capture still works and the queued read fails with a 401 recorded on the
# submission. Keep the real key in .env, never here.
#
# NOT named ANTHROPIC_API_KEY on purpose. That name is resolved first by Claude
# Code, the Anthropic SDKs and the `ant` CLI — ahead of an OAuth subscription
# profile — so anything that loads this file into the environment would silently
# switch those tools to billing the API account. Laravel reads .env off disk
# itself, so this app never needs the value in the environment at all.
COLLECTAI_ANTHROPIC_KEY=

# OCR Agent — reads packaging text off a capture.
#
# OCR_EFFORT is the dial to sweep before changing the model: high is the
# recommended starting point, and medium/low are worth measuring against real
# cards. OCR_MAX_TOKENS covers thinking as well as the JSON output.
OCR_MODEL=claude-opus-5
OCR_EFFORT=high
OCR_MAX_TOKENS=8000
OCR_MAX_PHOTOS=4
# Server-side retry on a substitute model when the requested one declines.
# Blank disables it; only meaningful on the Claude API.
OCR_FALLBACKS=default

# Metadata Agent — works out which real car an imported casting is a model of.
#
# METADATA_BATCH_SIZE is the dial with consequences: too small and a full import
# is thousands of round trips, too large and one answer that doesn't fit
# METADATA_MAX_TOKENS fails a whole batch. Raise the two together.
METADATA_MODEL=claude-opus-5
METADATA_EFFORT=high
METADATA_MAX_TOKENS=16000
METADATA_BATCH_SIZE=25
METADATA_FALLBACKS=default

# Confidence at or above which a Review Agent proposal skips manual approval.
# 1.0 means nothing auto-approves. Deliberately separate from the import
# threshold below: nothing a person photographed publishes itself.
REVIEW_AUTO_APPROVE_THRESHOLD=1.0

# Confidence at or above which the importer's own inferences — the Make/Model
# split behind a casting name — publish without a human. Err low: below the bar
# costs an invisible row in a backfill queue, above it costs a wrong car in the
# live catalogue that nothing flags again.
IMPORT_AUTO_APPROVE_THRESHOLD=0.9

# Confidence at or above which a *generation* claim is recorded — which of a
# nameplate's generations a casting belongs to. A separate, lower bar because it
# is a narrower claim that scores lower and fails more cheaply: too strict and
# every Corvette collapses back into one undifferentiated row, too loose and a
# '63 is filed with the '68s. See config/catalog.php for the measurements.
IMPORT_GENERATION_THRESHOLD=0.65

VITE_APP_NAME="${APP_NAME}"

# Prices (README §6). eBay developer keys from developer.ebay.com; EBAY_INSIGHTS=true only
# once eBay approves Marketplace Insights (sold prices) for your app.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_INSIGHTS=false
EBAY_LISTINGS_FALLBACK=false
PRICE_DAILY_BUDGET=4500
