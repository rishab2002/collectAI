APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=diecast
DB_USERNAME=diecast
DB_PASSWORD=diecast

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=diecast_dev_key

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (photo storage). R2_ENDPOINT is the S3 API endpoint,
# https://<account-id>.r2.cloudflarestorage.com — used for uploads only.
# R2_URL is the public read URL: either the bucket's r2.dev subdomain or a
# custom domain. Uploads fail loudly if these are unset, by design.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_URL=

# Which disk the capture screen writes to, and the per-photo size cap in KB.
# Set CAPTURE_DISK=local to use the capture screen before the R2 credentials
# above are real; submission_photos.disk records the choice per row, so photos
# captured locally keep resolving after the switch.
CAPTURE_DISK=r2
CAPTURE_MAX_PHOTO_KB=12288

# Catalog admin, created by AdminUserSeeder. Leaving ADMIN_PASSWORD blank makes
# the seeder generate one and print it once.
ADMIN_NAME="Catalog Admin"
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# OCR Agent. Without a key, capture still works and the queued read fails with
# a 401 recorded on the submission. Keep the real key in .env, never here.
#
# OCR_EFFORT is the dial to sweep before changing the model: high is the
# recommended starting point, and medium/low are worth measuring against real
# cards. OCR_MAX_TOKENS covers thinking as well as the JSON output.
ANTHROPIC_API_KEY=
OCR_MODEL=claude-opus-5
OCR_EFFORT=high
OCR_MAX_TOKENS=8000
OCR_MAX_PHOTOS=4
# Server-side retry on a substitute model when the requested one declines.
# Blank disables it; only meaningful on the Claude API.
OCR_FALLBACKS=default

# Confidence at or above which a Review Agent proposal skips manual approval.
# 1.0 means nothing auto-approves.
REVIEW_AUTO_APPROVE_THRESHOLD=1.0

VITE_APP_NAME="${APP_NAME}"
