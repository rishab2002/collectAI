# Production environment for collectai.club on AWS Lightsail.
#
# Copy to `.env` ON THE BOX and fill in every value marked CHANGE ME. This file
# is tracked in git, so never paste a real credential into it — the same rule as
# .env.example, for the same reason: a secret committed here stays in history
# whether or not a later commit deletes it.
#
#   cp .env.production.example .env
#   docker compose -f docker-compose.prod.yml run --rm web php artisan key:generate
#
# docker-compose.prod.yml mounts this file read-only into the web and worker
# containers and also reads it for its own ${...} substitutions, so the database
# credentials below are stated exactly once.

APP_NAME=collectAI
APP_ENV=production

# CHANGE ME — generate once with `php artisan key:generate` and never rotate it
# casually. Sessions are encrypted with this key, so replacing it logs everyone
# out; the admin account itself is unaffected.
APP_KEY=

# Off. With APP_DEBUG=true a stack trace on any 500 exposes the R2 credentials
# and the Anthropic key straight to the browser.
APP_DEBUG=false

# Load-bearing beyond cosmetics: redirect and session URLs are built from it,
# and ResolvesStoredUrl signs local-disk photo URLs against it. A stale value
# here sends every login redirect to the wrong host.
APP_URL=https://collectai.club

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# stderr, so `docker compose logs` is the whole story and nothing accumulates
# on a disk nobody is watching.
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=diecast
DB_USERNAME=diecast
# CHANGE ME — `openssl rand -base64 32`. Compose refuses to start if this is
# blank rather than defaulting to the development password.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# The site is HTTPS-only at the edge, so the session cookie should never be sent
# in the clear.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

# Must stay ABOVE the worker's --timeout of 300s (see docker/entrypoint.sh).
# Redis makes a job visible again after retry_after seconds; if that fires while
# the job is still running, a second worker picks it up and one capture becomes
# two billed vision calls. Laravel's default of 90 is far too low for an Opus 5
# vision call with thinking enabled.
REDIS_QUEUE_RETRY_AFTER=360

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Meilisearch is not deployed — laravel/scout is not installed, so nothing
# indexes. Left here only so the difference from .env.example is deliberate
# rather than an omission.
# MEILISEARCH_HOST=
# MEILISEARCH_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@collectai.club"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (photo storage) — already live and verified against the
# collectai-photos bucket. R2_ENDPOINT is the S3 API endpoint used for uploads;
# R2_URL is the public read host, which is why photo URLs outlive it.
# CHANGE ME — copy the four values from the existing development .env.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=collectai-photos
R2_ENDPOINT=
R2_URL=https://img.collectai.club

CAPTURE_DISK=r2
# Kept in step with docker/php/php.ini and nginx's client_max_body_size. Raising
# it means raising post_max_size and client_max_body_size too, or uploads fail
# before any validation message can be produced.
CAPTURE_MAX_PHOTO_KB=12288

# CHANGE ME — set a real password before the first seed. Left blank,
# AdminUserSeeder generates one and prints it exactly once, which on a remote
# box means scrolling back through container logs to find it.
ADMIN_NAME="Catalog Admin"
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=

# CHANGE ME — copy from the development .env. NOT named ANTHROPIC_API_KEY on
# purpose; see .env.example for the full reason.
COLLECTAI_ANTHROPIC_KEY=

OCR_MODEL=claude-opus-5
OCR_EFFORT=high
OCR_MAX_TOKENS=8000
OCR_MAX_PHOTOS=4
OCR_FALLBACKS=default

METADATA_MODEL=claude-opus-5
METADATA_EFFORT=high
METADATA_MAX_TOKENS=16000
METADATA_BATCH_SIZE=25
METADATA_FALLBACKS=default

# Unchanged from development, and both deliberately so. Nothing a person
# photographed auto-publishes (1.0); the importer's own inferences have their
# own, separate dial.
REVIEW_AUTO_APPROVE_THRESHOLD=1.0
IMPORT_AUTO_APPROVE_THRESHOLD=0.9
IMPORT_GENERATION_THRESHOLD=0.65

VITE_APP_NAME="${APP_NAME}"

# Prices — see README §6.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_INSIGHTS=false
EBAY_LISTINGS_FALLBACK=false
PRICE_DAILY_BUDGET=4500
